generator client {
  provider     = "prisma-client"
  // Генерируем CJS-совместимый клиент — NestJS использует CommonJS
  moduleFormat = "cjs"
  // Выводим в src/ чтобы TypeScript включал файлы в компиляцию
  output       = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // URL подключения берётся из prisma.config.ts → process.env["DATABASE_URL"]
}

/// Кому видны записи пользователя.
enum EntriesVisibility {
  /// Всем пользователям.
  PUBLIC
  /// Только друзьям.
  FRIENDS
  /// Только владельцу.
  PRIVATE
}

/// Пользователь приложения.
model User {
  /// Уникальный идентификатор.
  id          String  @id @default(cuid())
  /// Email адрес — используется для идентификации через OAuth.
  email       String  @unique
  /// Публичное имя пользователя в URL профиля.
  username    String? @unique
  /// Отображаемое имя — может содержать пробелы и спецсимволы.
  displayName String?
  /// Ссылка на аватар — берётся от OAuth-провайдера при регистрации.
  avatarUrl   String?
  /// Краткое описание профиля.
  bio         String?
  /// Кому видны записи пользователя.
  entriesVisibility EntriesVisibility @default(PUBLIC)

  /// OAuth-провайдер: 'google' | 'github'.
  provider   String
  /// Идентификатор пользователя на стороне провайдера.
  providerId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookEntries BookEntry[]

  /// События журнала активности этого пользователя.
  activities Activity[]

  /// Заявки в друзья, отправленные этим пользователем.
  sentFriendRequests     Friendship[] @relation("SentFriendRequests")
  /// Заявки в друзья, полученные этим пользователем.
  receivedFriendRequests Friendship[] @relation("ReceivedFriendRequests")

  @@unique([provider, providerId])
}

/// Статус книги в списке пользователя.
enum BookStatus {
  /// Прочитаю.
  WANT
  /// Читаю.
  READING
  /// Прочитал.
  DONE
  /// Брошено.
  DROPPED
}

/// Книга в общей библиотеке приложения.
model Book {
  /// Уникальный идентификатор.
  id          String   @id @default(cuid())
  /// Название книги.
  title       String
  /// Автор книги.
  author      String
  /// URL обложки.
  coverUrl    String?
  /// Описание книги.
  description String?
  /// Количество страниц.
  pageCount   Int?
  /// Жанры книги.
  genres      String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries BookEntry[]
}

/// Запись пользователя по конкретной книге.
model BookEntry {
  /// Уникальный идентификатор.
  id              String     @id @default(cuid())
  /// Идентификатор пользователя.
  userId          String
  /// Идентификатор книги.
  bookId          String
  /// Статус книги в списке пользователя.
  status          BookStatus
  /// Оценка от 1 до 10.
  rating          Int?
  /// Текущая страница.
  progress        Int?
  /// Дата начала чтения.
  startDate       DateTime?
  /// Дата завершения чтения.
  finishDate      DateTime?
  /// Дата последнего изменения оценки.
  ratingUpdatedAt DateTime?
  /// Дата последнего изменения статуса.
  statusUpdatedAt DateTime?
  /// Заметки пользователя.
  notes           String?
  /// Скрыта ли запись от других пользователей.
  isHidden        Boolean    @default(false)
  /// Дата удаления — запись хранится в корзине и может быть восстановлена.
  deletedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  /// События журнала, относящиеся к этой записи.
  activities Activity[]

  /// Одна запись на пользователя на книгу.
  @@unique([userId, bookId])
}

/// Тип события в журнале активности.
enum ActivityType {
  /// Запись добавлена в список.
  ENTRY_ADDED
  /// Изменён статус записи.
  STATUS_CHANGED
  /// Поставлена или изменена оценка.
  RATED
}

/// Тип записи, к которой относится событие.
enum ActivitySubject {
  /// Книга.
  BOOK
}

/// Событие журнала активности пользователя.
model Activity {
  /// Уникальный идентификатор.
  id      String          @id @default(cuid())
  /// Автор действия.
  userId  String
  /// Тип события.
  type    ActivityType
  /// Тип записи — позволяет фильтровать ленту без обращения к самой записи.
  subject ActivitySubject
  /// Подробности события: что было и что стало.
  payload Json?

  /// Запись о книге, к которой относится событие.
  /// При добавлении других типов записей рядом появится своё поле.
  bookEntryId String?

  /// Дата удаления — событие скрыто пользователем, но может быть восстановлено.
  deletedAt DateTime?

  createdAt DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookEntry BookEntry? @relation(fields: [bookEntryId], references: [id], onDelete: Cascade)

  /// Лента запрашивает события пользователей по убыванию даты.
  @@index([userId, createdAt(sort: Desc)])
  /// Хронология по конкретной записи.
  @@index([bookEntryId, createdAt(sort: Desc)])
}

/// Статус заявки в друзья.
enum FriendshipStatus {
  /// Заявка отправлена, ещё не рассмотрена.
  PENDING
  /// Заявка принята — пользователи друзья.
  ACCEPTED
}

/// Заявка в друзья или уже принятая дружба между двумя пользователями.
model Friendship {
  /// Уникальный идентификатор.
  id         String           @id @default(cuid())
  /// Идентификатор отправителя заявки.
  senderId   String
  /// Идентификатор адресата заявки.
  receiverId String
  /// Статус заявки.
  status     FriendshipStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Пользователь, отправивший заявку.
  sender   User @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  /// Пользователь, получивший заявку.
  receiver User @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  /// Одна заявка/дружба на пару отправитель-адресат в конкретном направлении.
  @@unique([senderId, receiverId])
}
